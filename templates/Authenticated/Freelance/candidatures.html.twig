{% extends 'base.html.twig' %}

{% block title %}Mes candidatures{% endblock %}

{% block header_content %}
    <h2>Mes candidatures</h2>
    <p>Retrouvez ici toutes vos candidatures.</p>
{% endblock %}

{% block body %}
    <section id="main">
        <div class="container">
            <div class="row">
                <div class="col-12">

                </div>
                <div class="col-12">

                    <!-- Blog -->
                    <section>
                        <div class="row">
                            {% for mission in candidatures %}
                                <div class="col-6 col-12-small">
                                    <section class="box">
                                        {% if mission.isImageUploaded %}
                                            {# Image uploadée via Vich #}
                                            <a class="image featured">
                                                <img src="{{ vich_uploader_asset(mission, 'imageFile') }}" alt="Image mission" />
                                            </a>
                                        {% else %}
                                            {# Image choisie parmi les existantes #}
                                            <a class="image featured">
                                                <img src="{{ asset('images/' ~ mission.imageName) }}" alt="Image mission" />
                                            </a>
                                        {% endif %}

                                        <header>
                                            <h3>{{ mission.titre }}</h3>
                                            <p>Publiée le {{ mission.datePublication|format_datetime('full', 'short') }}</p>
                                        </header>
                                        <p>{{ mission.description|length > 50 ? mission.description[:50] ~ '...' : mission.description }}</p>
                                        <footer>
                                            <h5>Candidature envoyée.</h5>
                                            <a href="#" class="button col-1-medium">Suivre ma candidature</a>
                                            <a href="{{ path('app_mission_enSavoirPlus', {'id': mission.id}) }}" class="button col-1-medium">En savoir plus</a>
                                        </footer>
                                    </section>
                                </div>
                            {% endfor %}
                        </div>
                    </section>

                </div>
            </div>
        </div>
    </section>
{% endblock %}