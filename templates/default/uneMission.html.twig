{% extends 'base.html.twig' %}

{% block title %}{{ mission.titre }}{% endblock %}

{%  block header_content %}
<h2>{{mission.titre}}</h2>
<p>Retrouvez les informations concernant la mission sélectionnée ci-dessous.</p>
{% endblock %}

{% block body %}
    <section id="main">
        <div class="container">
            <div class="row">
                <div class="col-12">

                </div>
                <div class="col-12">

                    <!-- Blog -->
                    <section>
                        <div class="row">
                            <div class="col-6 col-12-small">
                                <section class="box">
                                    {% if mission.isImageUploaded %}
                                        {# Image uploadée via Vich #}
                                        <a class="image featured">
                                            <img src="{{ vich_uploader_asset(mission, 'imageFile') }}" alt="Image mission" />
                                        </a>
                                    {% else %}
                                        {# Image choisie parmi les existantes #}
                                        <a class="image featured">
                                            <img src="{{ asset('images/' ~ mission.imageName) }}" alt="Image mission" />
                                        </a>
                                    {% endif %}

                                    <header>
                                        <h3>{{ mission.titre }}</h3>
                                        <p>Publiée le {{ mission.datePublication|format_datetime('full', 'short') }}</p>
                                    </header>
                                    <p>{{ mission.description|length > 50 ? mission.description[:50] ~ '...' : mission.description }}</p>
                                </section>
                            </div>
                            <div class="col-6 col-12-small">
                                <h2>Description détaillée de la mission :</h2>
                                <p>{{ mission.description }}</p>
                                <h2>Duréé :</h2>
                                <p>{{ mission.duree }}</p>
                                <h2>nombre de candidatures :</h2><p>{{ mission.nombreCandidatures }}</p>
                                <footer>
                                    {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                                    <a href="{{ path('app_freelance_postuler', {'id': mission.id}) }}" class="button icon solid fa-file-alt">Candidater</a>
                                    {% endif %}
                                    {% if not  is_granted('IS_AUTHENTICATED_FULLY') %}
                                        <p>Seulement les développeurs authentifiés peuvent postuler. Connectez-vous <a href="{{ path('app_login') }}">ici</a></p>
                                    {% endif %}
                                    <p>Mission publiée par : <a href="{{ path('app_profil', {'id': mission.getClient().getId()}) }}">{{ mission.client.nom }}</a></p>
                                </footer>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </section>
{% endblock %}